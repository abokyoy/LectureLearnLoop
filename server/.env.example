# LectureLearnLoop 服务端配置模板
# 复制为 server/.env 并填入真实值。server/.env 已被 .gitignore 排除，禁止提交。
# worktree 并行开发：每个工作树复制本模板后修改 SERVER_PORT（主=6001，分支=6011-6014）

SERVER_PORT=6001
JWT_SECRET=change-me
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPGRAM_API_KEY=
# 出网代理（V2RAYN）；localhost 调用绝不走代理
HTTP_PROXY_URL=http://127.0.0.1:10808

# 数据库（全局后端开关 + PostgreSQL 连接）
# 注意：默认 sqlite 仅为回退能力；worktree 环境务必设为 postgres，
# 否则 config.py 会打 WARN，且会静默新建空 SQLite 库导致"数据丢失"假象。
DB_BACKEND=postgres
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=lecturelearnloop
PG_USER=postgres
PG_PASSWORD=
PG_POOL_MIN=2
PG_POOL_MAX=20
