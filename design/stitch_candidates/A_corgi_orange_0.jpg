<!DOCTYPE html>

<html class="h-full" lang="zh-CN"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>柯基乐园 - 工作台</title>
<!-- Material Symbols Outlined -->
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<!-- Google Fonts: Plus Jakarta Sans & JetBrains Mono -->
<link href="https://fonts.googleapis.com" rel="preconnect"/>
<link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&amp;family=Plus+Jakarta+Sans:wght@400;500;600;700&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<!-- Tailwind CSS v3 -->
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<script id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          "colors": {
            "on-tertiary-container": "#003934",
            "secondary": "#695d4a",
            "secondary-fixed": "#f2e0c8",
            "background": "#fff8f2",
            "surface-container": "#f4ede6",
            "on-tertiary": "#ffffff",
            "on-error-container": "#93000a",
            "on-secondary-container": "#6f6350",
            "on-secondary": "#ffffff",
            "on-primary-container": "#582200",
            "tertiary-fixed": "#89f5e7",
            "tertiary-container": "#37ab9e",
            "surface-container-low": "#faf2eb",
            "error-container": "#ffdad6",
            "outline-variant": "#e0c0b1",
            "on-background": "#1e1b17",
            "surface-tint": "#9d4300",
            "on-surface": "#1e1b17",
            "inverse-surface": "#33302c",
            "error": "#ba1a1a",
            "tertiary": "#006a61",
            "surface": "#fff8f2",
            "primary-container": "#f97316",
            "primary": "#9d4300",
            "on-tertiary-fixed-variant": "#005049",
            "secondary-fixed-dim": "#d5c4ad",
            "tertiary-fixed-dim": "#6bd8cb",
            "surface-bright": "#fff8f2",
            "inverse-on-surface": "#f7efe9",
            "surface-variant": "#e8e1db",
            "surface-dim": "#e0d9d2",
            "primary-fixed": "#ffdbca",
            "on-primary-fixed-variant": "#783200",
            "on-primary": "#ffffff",
            "on-secondary-fixed-variant": "#504534",
            "on-primary-fixed": "#341100",
            "primary-fixed-dim": "#ffb690",
            "secondary-container": "#f2e0c8",
            "on-tertiary-fixed": "#00201d",
            "on-surface-variant": "#584237",
            "outline": "#8c7164",
            "on-secondary-fixed": "#231a0c",
            "surface-container-high": "#eee7e0",
            "on-error": "#ffffff",
            "inverse-primary": "#ffb690",
            "surface-container-lowest": "#ffffff",
            "surface-container-highest": "#e8e1db"
          },
          "borderRadius": {
            "DEFAULT": "0.25rem",
            "lg": "0.5rem",
            "xl": "0.75rem",
            "full": "9999px"
          },
          "spacing": {
            "space-xl": "2.25rem",
            "space-md": "1rem",
            "margin": "1.75rem",
            "space-lg": "1.5rem",
            "space-xs": "0.25rem",
            "space-sm": "0.5rem",
            "gutter": "1.25rem"
          },
          "fontFamily": {
            "headline-lg-mobile": ["Plus Jakarta Sans"],
            "display-lg": ["Plus Jakarta Sans"],
            "label-md": ["Plus Jakarta Sans"],
            "label-code": ["JetBrains Mono"],
            "body-md": ["Plus Jakarta Sans"],
            "body-lg": ["Plus Jakarta Sans"],
            "headline-sm": ["Plus Jakarta Sans"],
            "headline-md": ["Plus Jakarta Sans"],
            "headline-lg": ["Plus Jakarta Sans"],
            "body-sm": ["Plus Jakarta Sans"]
          },
          "fontSize": {
            "headline-lg-mobile": ["24px", { "lineHeight": "32px", "letterSpacing": "-0.01em", "fontWeight": "700" }],
            "display-lg": ["40px", { "lineHeight": "48px", "letterSpacing": "-0.02em", "fontWeight": "700" }],
            "label-md": ["13px", { "lineHeight": "16px", "letterSpacing": "0.01em", "fontWeight": "600" }],
            "label-code": ["12px", { "lineHeight": "16px", "fontWeight": "500" }],
            "body-md": ["14px", { "lineHeight": "22px", "fontWeight": "400" }],
            "body-lg": ["16px", { "lineHeight": "26px", "fontWeight": "400" }],
            "headline-sm": ["18px", { "lineHeight": "26px", "fontWeight": "600" }],
            "headline-md": ["22px", { "lineHeight": "30px", "letterSpacing": "-0.01em", "fontWeight": "600" }],
            "headline-lg": ["30px", { "lineHeight": "38px", "letterSpacing": "-0.015em", "fontWeight": "700" }],
            "body-sm": ["12px", { "lineHeight": "18px", "fontWeight": "400" }]
          }
        },
      },
    }
  </script>
</head>
<body class="bg-background text-on-surface font-body-md text-body-md antialiased min-h-screen flex selection:bg-primary-fixed selection:text-on-primary-fixed">
<!-- LEFT SIDEBAR: SideNavBar (Shared Component) -->
<aside class="h-screen w-64 fixed left-0 top-0 flex flex-col justify-between p-4 border-r border-outline-variant/30 shadow-sm bg-surface z-50">
<div class="flex flex-col gap-6">
<!-- Header / Logo -->
<div class="flex items-center gap-3 px-2 py-1.5">
<div class="w-10 h-10 rounded-xl bg-primary-container/20 border border-outline-variant/30 flex items-center justify-center text-primary shadow-sm overflow-hidden flex-shrink-0">
<img class="w-full h-full object-cover" data-alt="A warm and friendly stylized Welsh Corgi illustration mascot head wearing small study glasses, bathed in cheerful golden sunlight, high quality digital vector art in soft peach and orange tones." src="https://lh3.googleusercontent.com/aida-public/AB6AXuC_zb7dtPD4NgCh3nHIiHGQuv0JMILLdAB05lAsBVlwciXgNR64l7HpR5MmhDerEK-80HA1WjQnTxY_3tse1auKNcwKwSOtuHNWqehkmQYH9SJkUbsK91ovospHsuqgm8tv2l2R7DtIcKqxGM-nTbCZlbVmbUqRq5CaJw42qTmGpA_8E0D2xWgZz28ozicKWuDRIBCMH95FTfTEluJVAAxoWWtpLMPx6cVqzlaFYvCz9ZFdwt7fZqeu54-POuMMK7Np9AnKWqJRwK-4"/>
</div>
<div class="flex flex-col min-w-0">
<span class="font-headline-md text-headline-md text-primary font-bold tracking-tight truncate">柯基乐园</span>
<div class="flex items-center gap-1.5">
<span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
<span class="font-body-sm text-body-sm text-secondary truncate">伴学模式激活</span>
</div>
</div>
</div>
<!-- Navigation Tabs (Tabs: 工作台, 学, 练, 记, 知识库, 设置) -->
<nav class="flex flex-col gap-1.5">
<!-- 工作台 (Active State) -->
<a class="flex items-center gap-3 px-3 py-2.5 rounded-xl bg-secondary-container text-primary font-semibold shadow-sm transition-all duration-150 active:scale-[0.98]" href="#">
<span class="material-symbols-outlined text-primary" data-icon="space_dashboard" style="font-variation-settings: 'FILL' 1;">space_dashboard</span>
<span class="font-label-md text-label-md tracking-wide">工作台</span>
</a>
<!-- 学 -->
<a class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-on-surface-variant hover:bg-surface-container-high hover:text-primary transition-colors duration-200 active:scale-[0.98]" href="#">
<span class="material-symbols-outlined" data-icon="menu_book">menu_book</span>
<span class="font-label-md text-label-md tracking-wide">学</span>
</a>
<!-- 练 -->
<a class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-on-surface-variant hover:bg-surface-container-high hover:text-primary transition-colors duration-200 active:scale-[0.98]" href="#">
<span class="material-symbols-outlined" data-icon="fitness_center">fitness_center</span>
<span class="font-label-md text-label-md tracking-wide">练</span>
</a>
<!-- 记 -->
<a class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-on-surface-variant hover:bg-surface-container-high hover:text-primary transition-colors duration-200 active:scale-[0.98]" href="#">
<span class="material-symbols-outlined" data-icon="edit_note">edit_note</span>
<span class="font-label-md text-label-md tracking-wide">记</span>
</a>
<!-- 知识库 -->
<a class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-on-surface-variant hover:bg-surface-container-high hover:text-primary transition-colors duration-200 active:scale-[0.98]" href="#">
<span class="material-symbols-outlined" data-icon="auto_stories">auto_stories</span>
<span class="font-label-md text-label-md tracking-wide">知识库</span>
</a>
<!-- 设置 -->
<a class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-on-surface-variant hover:bg-surface-container-high hover:text-primary transition-colors duration-200 active:scale-[0.98]" href="#">
<span class="material-symbols-outlined" data-icon="settings">settings</span>
<span class="font-label-md text-label-md tracking-wide">设置</span>
</a>
</nav>
</div>
<!-- Bottom Profile Card & Status -->
<div class="flex flex-col gap-3 pt-3 border-t border-outline-variant/30">
<!-- Corgi Companion Status Widget -->
<div class="p-3 rounded-xl bg-surface-container-low border border-outline-variant/30 flex items-center justify-between">
<div class="flex items-center gap-2.5">
<div class="w-8 h-8 rounded-lg bg-primary-fixed flex items-center justify-center text-primary-container">
<span class="material-symbols-outlined text-[20px]" data-icon="pets">pets</span>
</div>
<div>
<p class="font-label-md text-label-md text-on-surface font-semibold">柯基小萌已就位</p>
<p class="font-body-sm text-body-sm text-secondary">精力充沛 100%</p>
</div>
</div>
<span class="text-xs px-2 py-0.5 rounded-full bg-primary-container text-on-primary font-medium">Lv.7</span>
</div>
<!-- Footer: 个人中心 / User Profile -->
<a class="flex items-center gap-3 px-3 py-2.5 rounded-xl hover:bg-surface-container-high text-on-surface-variant hover:text-primary transition-colors duration-200 active:scale-[0.98]" href="#">
<div class="w-8 h-8 rounded-full border border-outline-variant/40 overflow-hidden flex-shrink-0 bg-secondary-fixed">
<img class="w-full h-full object-cover" data-alt="Portrait avatar of a cheerful young Asian student with rounded glasses and warm smiling expression, softly lit with minimal clean background, warm orange ambient lighting accents." src="https://lh3.googleusercontent.com/aida-public/AB6AXuBdN5rRaUOTazSwpWgBGrl38cH1NMLnt2_ulypwaSZ0p-3t5gjfZYLF75qSZ4GD0cLYeNEwyZsPBYsWeHapNbL5E7j2HHCV11npDO8dbI9ZPjr_roJdUC8KP2iZvjGtCWhjKEhjrIreylozifl3jgIA2ok-tp0R8f_xhQ5wgRyc16H-56SjQ5JVM3Ge8GhXZHN0yIbQeQu4-uLaUkzaS9-03uDVxL1eGkWxz7aZRRQIiIuvKexFCDqX5A3XUFwlY1v_kQsb0svbgOV2"/>
</div>
<div class="flex flex-col min-w-0">
<span class="font-label-md text-label-md text-on-surface font-semibold truncate">林小柯</span>
<span class="font-body-sm text-body-sm text-secondary truncate">高三拔尖突破期</span>
</div>
<span class="material-symbols-outlined ml-auto text-secondary text-sm" data-icon="chevron_right">chevron_right</span>
</a>
</div>
</aside>
<!-- TOP APP BAR: TopNavBar (Shared Component) -->
<header class="h-16 w-[calc(100%-16rem)] fixed top-0 right-0 z-40 px-6 border-b border-outline-variant/30 shadow-sm bg-surface/80 backdrop-blur-md flex items-center justify-between">
<!-- Left: Search & Greeting -->
<div class="flex items-center gap-6 flex-1 max-w-xl">
<div class="relative w-80">
<span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline text-[20px]" data-icon="search">search</span>
<input class="w-full bg-surface-container-lowest border border-outline-variant/40 rounded-xl pl-9 pr-14 py-2 font-body-sm text-body-sm text-on-surface placeholder:text-outline focus:outline-none focus:ring-2 focus:ring-primary-container/30 focus:border-primary-container transition-all" placeholder="搜索知识点、考题或错题..." type="text"/>
<kbd class="absolute right-2.5 top-1/2 -translate-y-1/2 font-label-code text-label-code bg-surface-container-high px-1.5 py-0.5 rounded text-secondary border border-outline-variant/40">⌘K</kbd>
</div>
<div class="hidden xl:flex items-center gap-1.5 text-secondary">
<span class="font-body-sm text-body-sm">早安，小柯！✨ 今天也是元气满满攻克考点的一天</span>
</div>
</div>
<!-- Right: Streaks, Clock, Trailing Actions & AI Primary Pill Action -->
<div class="flex items-center gap-3.5">
<!-- Streak Badge -->
<div class="flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-surface-container-lowest border border-outline-variant/40 shadow-sm">
<span class="material-symbols-outlined text-primary-container text-[18px]" data-icon="local_fire_department" style="font-variation-settings: 'FILL' 1;">local_fire_department</span>
<span class="font-label-md text-label-md text-on-surface font-semibold">连续学习 14 天</span>
</div>
<!-- Focus Clock Capsule -->
<div class="flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-surface-container-low border border-outline-variant/30">
<span class="material-symbols-outlined text-secondary text-[18px]" data-icon="timer">timer</span>
<span class="font-label-code text-label-code text-secondary font-medium">今日专注 45m</span>
</div>
<!-- Trailing Action: Notifications -->
<button class="w-9 h-9 rounded-xl flex items-center justify-center text-on-surface-variant hover:bg-surface-container hover:text-primary transition-colors duration-150 active:scale-95 relative" title="消息通知">
<span class="material-symbols-outlined text-[20px]" data-icon="notifications">notifications</span>
<span class="w-2 h-2 rounded-full bg-primary-container absolute top-2 right-2 ring-2 ring-surface"></span>
</button>
<!-- Trailing Primary Action: 问问伴学柯基 -->
<button class="flex items-center gap-2 px-4 py-2 rounded-full bg-primary-container text-on-primary font-semibold font-label-md text-label-md shadow-sm hover:bg-primary transition-all duration-150 active:scale-95">
<span class="material-symbols-outlined text-[18px]" data-icon="smart_toy">smart_toy</span>
<span>问问伴学柯基</span>
</button>
</div>
</header>
<!-- MAIN CANVAS -->
<main class="ml-64 mt-16 flex-1 min-h-[calc(100vh-4rem)] p-8 overflow-y-auto">
<div class="max-w-7xl mx-auto space-y-8">
<!-- SECTION 1: 今日 AI 智能冲刺 Banner (Bento Hero) -->
<section class="w-full bg-gradient-to-r from-surface-container-lowest via-surface-container-low to-secondary-container/40 rounded-xl p-6 border border-outline-variant/30 shadow-[0_2px_10px_-2px_rgba(120,113,108,0.04)] flex flex-col md:flex-row items-center justify-between gap-6 relative overflow-hidden">
<div class="absolute -right-8 -bottom-8 w-64 h-64 rounded-full bg-primary-fixed/20 blur-3xl pointer-events-none"></div>
<div class="flex items-start gap-5 z-10">
<div class="w-14 h-14 rounded-xl bg-primary-container text-on-primary flex items-center justify-center flex-shrink-0 shadow-md">
<span class="material-symbols-outlined text-[30px]" data-icon="bolt" style="font-variation-settings: 'FILL' 1;">bolt</span>
</div>
<div class="space-y-1.5">
<div class="flex items-center gap-2">
<span class="px-2.5 py-0.5 rounded-full bg-secondary-fixed text-on-secondary-fixed font-label-code text-label-code uppercase tracking-wider font-semibold">今日推荐攻坚</span>
<span class="font-body-sm text-body-sm text-secondary">预计用时 25 分钟 · 提分权重 ★★★★★</span>
</div>
<h1 class="font-headline-lg text-headline-lg text-on-surface tracking-tight">考点攻坚：高中物理「电磁感应与楞次定律」动态分析</h1>
<p class="font-body-md text-body-md text-secondary">
              伴学柯基已为你整理出昨晚模考丢分的 3 个阻尼振荡变式题，配合动态受力图谱，今天一次彻底搞懂！
            </p>
</div>
</div>
<!-- Banner Right Actions & Mini Progress Dial -->
<div class="flex items-center gap-6 flex-shrink-0 z-10">
<div class="flex items-center gap-3">
<div class="relative w-12 h-12 flex items-center justify-center">
<svg class="w-full h-full -rotate-90" viewbox="0 0 36 36">
<path class="text-surface-variant stroke-current" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke-width="3.5"></path>
<path class="text-primary-container stroke-current" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke-dasharray="68, 100" stroke-linecap="round" stroke-width="3.5"></path>
</svg>
<span class="absolute font-label-code text-label-code font-bold text-on-surface">68%</span>
</div>
<div class="text-left">
<p class="font-label-md text-label-md text-on-surface font-semibold">模块突破率</p>
<p class="font-body-sm text-body-sm text-secondary">差 2 道综合题达标</p>
</div>
</div>
<button class="px-5 py-3 rounded-xl bg-primary-container hover:bg-primary text-on-primary font-label-md text-label-md font-semibold transition-all duration-150 shadow-sm active:scale-95 flex items-center gap-2">
<span>快速开始冲刺</span>
<span class="material-symbols-outlined text-[18px]" data-icon="play_arrow" style="font-variation-settings: 'FILL' 1;">play_arrow</span>
</button>
</div>
</section>
<!-- SECTION 2: 核心学习闭环「学 · 练 · 记」三列 Bento 交互网格 -->
<div>
<div class="flex items-center justify-between mb-4">
<div>
<h2 class="font-headline-md text-headline-md text-on-surface tracking-tight">学 · 练 · 记 闭环引擎</h2>
<p class="font-body-sm text-body-sm text-secondary">认知输入、靶向强化到长效内化，环环相扣的高能提分节奏</p>
</div>
<span class="font-label-md text-label-md text-primary font-semibold flex items-center gap-1 cursor-pointer hover:underline">
            查看个人学习雷达
            <span class="material-symbols-outlined text-[16px]" data-icon="arrow_forward">arrow_forward</span>
</span>
</div>
<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
<!-- 卡片 1: 学 · 新知精读 -->
<div class="bg-surface-container-lowest rounded-xl p-6 border border-outline-variant/30 shadow-[0_2px_10px_-2px_rgba(120,113,108,0.04)] hover:shadow-[0_12px_24px_-4px_rgba(249,115,22,0.08)] transition-all duration-200 flex flex-col justify-between group">
<div class="space-y-4">
<div class="flex items-center justify-between">
<div class="w-12 h-12 rounded-xl bg-primary-fixed/50 text-primary flex items-center justify-center">
<span class="material-symbols-outlined text-[26px]" data-icon="menu_book">menu_book</span>
</div>
<span class="px-2.5 py-1 rounded-full bg-surface-container-low text-secondary font-label-code text-label-code">Step 1 · 认知输入</span>
</div>
<div>
<h3 class="font-headline-sm text-headline-sm text-on-surface group-hover:text-primary transition-colors">新知探索与精读</h3>
<p class="font-body-md text-body-md text-secondary mt-1 line-clamp-2">
                  AI 知识图谱深度拆解，理清核心考点逻辑链条，快速消除理解盲区。
                </p>
</div>
<!-- Metric Indicator -->
<div class="bg-surface-container-low/60 rounded-xl p-3 flex items-center justify-between border border-outline-variant/20">
<span class="font-body-sm text-body-sm text-secondary">当前模块掌握度</span>
<span class="font-headline-md text-headline-md text-primary font-bold">85%</span>
</div>
</div>
<div class="mt-6 pt-4 border-t border-outline-variant/20 flex items-center justify-between">
<span class="font-body-sm text-body-sm text-outline">推荐：微专题视频 + 导图</span>
<button class="px-4 py-2 rounded-xl bg-secondary-container hover:bg-primary hover:text-on-primary text-on-primary-container font-label-md text-label-md font-semibold transition-all duration-150 active:scale-95 flex items-center gap-1.5">
<span>开启今日伴学</span>
<span class="material-symbols-outlined text-[16px]" data-icon="chevron_right">chevron_right</span>
</button>
</div>
</div>
<!-- 卡片 2: 练 · 靶向专项 -->
<div class="bg-surface-container-lowest rounded-xl p-6 border border-outline-variant/30 shadow-[0_2px_10px_-2px_rgba(120,113,108,0.04)] hover:shadow-[0_12px_24px_-4px_rgba(249,115,22,0.08)] transition-all duration-200 flex flex-col justify-between group">
<div class="space-y-4">
<div class="flex items-center justify-between">
<div class="w-12 h-12 rounded-xl bg-primary-container text-on-primary flex items-center justify-center shadow-sm">
<span class="material-symbols-outlined text-[26px]" data-icon="fitness_center">fitness_center</span>
</div>
<span class="px-2.5 py-1 rounded-full bg-primary-fixed text-on-primary-fixed-variant font-label-code text-label-code font-semibold">Step 2 · 攻防演练</span>
</div>
<div>
<h3 class="font-headline-sm text-headline-sm text-on-surface group-hover:text-primary transition-colors">靶向专项刷题</h3>
<p class="font-body-md text-body-md text-secondary mt-1 line-clamp-2">
                  基于薄弱考点精准组卷，攻防自适应动态演练，实时追溯解题卡点。
                </p>
</div>
<!-- Metric Indicator -->
<div class="bg-surface-container-low/60 rounded-xl p-3 flex items-center justify-between border border-outline-variant/20">
<span class="font-body-sm text-body-sm text-secondary">今日精选题量</span>
<div class="flex items-baseline gap-1">
<span class="font-headline-md text-headline-md text-primary font-bold">12</span>
<span class="font-body-sm text-body-sm text-secondary">题</span>
</div>
</div>
</div>
<div class="mt-6 pt-4 border-t border-outline-variant/20 flex items-center justify-between">
<span class="font-body-sm text-body-sm text-outline">已匹配 2 道易错变式题</span>
<button class="px-4 py-2 rounded-xl bg-primary-container hover:bg-primary text-on-primary font-label-md text-label-md font-semibold transition-all duration-150 active:scale-95 shadow-sm flex items-center gap-1.5">
<span>开始自适应练习</span>
<span class="material-symbols-outlined text-[16px]" data-icon="bolt">bolt</span>
</button>
</div>
</div>
<!-- 卡片 3: 记 · 闪卡胶囊 -->
<div class="bg-surface-container-lowest rounded-xl p-6 border border-outline-variant/30 shadow-[0_2px_10px_-2px_rgba(120,113,108,0.04)] hover:shadow-[0_12px_24px_-4px_rgba(249,115,22,0.08)] transition-all duration-200 flex flex-col justify-between group">
<div class="space-y-4">
<div class="flex items-center justify-between">
<div class="w-12 h-12 rounded-xl bg-tertiary-fixed text-on-tertiary-container flex items-center justify-center">
<span class="material-symbols-outlined text-[26px]" data-icon="edit_note">edit_note</span>
</div>
<span class="px-2.5 py-1 rounded-full bg-surface-container-low text-secondary font-label-code text-label-code">Step 3 · 长效固化</span>
</div>
<div>
<h3 class="font-headline-sm text-headline-sm text-on-surface group-hover:text-primary transition-colors">闪卡记忆胶囊</h3>
<p class="font-body-md text-body-md text-secondary mt-1 line-clamp-2">
                  基于艾宾浩斯遗忘曲线黄金周期，抗遗忘长效内化，随时碎片化温故。
                </p>
</div>
<!-- Metric Indicator -->
<div class="bg-surface-container-low/60 rounded-xl p-3 flex items-center justify-between border border-outline-variant/20">
<span class="font-body-sm text-body-sm text-secondary">今日待复习卡片</span>
<div class="flex items-baseline gap-1">
<span class="font-headline-md text-headline-md text-tertiary font-bold">18</span>
<span class="font-body-sm text-body-sm text-secondary">张</span>
</div>
</div>
</div>
<div class="mt-6 pt-4 border-t border-outline-variant/20 flex items-center justify-between">
<span class="font-body-sm text-body-sm text-outline">3 个公式已进入临界遗忘期</span>
<button class="px-4 py-2 rounded-xl bg-surface-container-high hover:bg-primary-container hover:text-on-primary text-on-surface font-label-md text-label-md font-semibold transition-all duration-150 active:scale-95 flex items-center gap-1.5">
<span>进入快速过卡</span>
<span class="material-symbols-outlined text-[16px]" data-icon="style">style</span>
</button>
</div>
</div>
</div>
</div>
<!-- SECTION 3: 最近学习活动记录 (Activity Ledger) -->
<section class="bg-surface-container-lowest rounded-xl p-6 border border-outline-variant/30 shadow-[0_2px_10px_-2px_rgba(120,113,108,0.04)]">
<div class="flex items-center justify-between pb-4 border-b border-outline-variant/30 mb-4">
<div class="flex items-center gap-2.5">
<span class="material-symbols-outlined text-primary text-[22px]" data-icon="history">history</span>
<h2 class="font-headline-sm text-headline-sm text-on-surface">最近学习活动</h2>
</div>
<div class="flex items-center gap-2">
<span class="font-body-sm text-body-sm text-secondary">自动同步至 AI 伴学大脑</span>
<button class="text-primary font-label-md text-label-md hover:underline font-semibold ml-2">完整档案</button>
</div>
</div>
<div class="space-y-3.5">
<!-- Activity Record 1: 练 -->
<div class="p-4 rounded-xl bg-surface-container-low/40 hover:bg-surface-container-low transition-colors duration-150 border border-outline-variant/20 flex items-center justify-between">
<div class="flex items-center gap-4">
<div class="w-10 h-10 rounded-xl bg-primary-fixed flex items-center justify-center text-primary flex-shrink-0">
<span class="material-symbols-outlined text-[20px]" data-icon="fitness_center">fitness_center</span>
</div>
<div class="space-y-0.5">
<div class="flex items-center gap-2">
<span class="font-headline-sm text-base text-on-surface font-semibold">《函数单调性与极值》自适应闯关</span>
<span class="px-2 py-0.5 rounded text-xs bg-emerald-100 text-emerald-800 font-semibold font-label-code">得分 90%</span>
<span class="text-xs text-secondary font-label-code">耗时 15 分钟</span>
</div>
<p class="font-body-sm text-body-sm text-secondary">
