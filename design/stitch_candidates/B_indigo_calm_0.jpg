</div>
</div>
</div>
<div class="flex items-center gap-3 self-end md:self-center">
<button class="px-3 py-1.5 rounded-lg border border-outline-variant/50 hover:border-outline text-secondary hover:text-on-surface font-label-sm text-label-sm font-medium transition-colors">
                回顾卡片
              </button>
</div>
</div>
<!-- 活动 3 -->
<div class="py-3.5 flex flex-col md:flex-row md:items-center justify-between gap-4 hover:bg-surface-container-low/50 px-3 rounded-xl transition-colors">
<div class="flex items-center gap-3.5">
<div class="w-10 h-10 rounded-xl bg-surface-container flex items-center justify-center text-secondary shrink-0">
<span class="material-symbols-outlined text-[20px]">hub</span>
</div>
<div class="space-y-1">
<div class="flex items-center gap-2 flex-wrap">
<h4 class="font-body-md text-body-md font-semibold text-on-surface">《近代史纲要脉络全景图》思维导图构建</h4>
<span class="px-2 py-0.5 rounded text-[11px] font-semibold bg-surface-container text-on-surface-variant">深度评级：A级</span>
